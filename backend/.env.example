JWT_SECRET=
LISTEN_ADDR=0.0.0.0:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development
DATABASE_URL_DEVELOPMENT=postgresql://postgres:postgres@localhost:5432/simpletracker_dev?sslmode=disable
DATABASE_URL_PRODUCTION=postgresql://user:password@database-host:5432/simpletracker_prod?sslmode=verify-full
DEV_AUTH_TOKEN=
DEV_AUTH_USER=dev
ALLOW_BYPASS=false
REGISTER_ENABLED=false
LOGIN_RATE_LIMIT_WINDOW_SEC=900
LOGIN_RATE_LIMIT_MAX_IP=30
LOGIN_RATE_LIMIT_MAX_USERNAME=5
LOGIN_SPRAY_WINDOW_SEC=600
LOGIN_SPRAY_MAX_USERNAMES=5
LOGIN_SPRAY_BLOCK_SEC=86400
TRUSTED_PROXIES=
# Optional: if set, used instead of DATABASE_URL_DEVELOPMENT / DATABASE_URL_PRODUCTION.
# DATABASE_URL=
# The schema owner, for cmd/migrate, devseed, devuser and e2eseed (the server never uses it).
# Unset, they use the server's DSN above. The server should connect as simpletrack_app (see
# docs/ARCHITECTURE.md "Database roles"); `migrate up` sets that role's password from its DSN.
# DATABASE_OWNER_URL=
# Connection pool (defaults: 20 open, 10 idle, 30m lifetime, 5m idle time).
# DB_MAX_OPEN_CONNS=
# DB_MAX_IDLE_CONNS=
# DB_CONN_MAX_LIFETIME=
# DB_CONN_MAX_IDLE_TIME=
# APP_ENV=production
# Session lifetime in seconds (default 31536000 = 365 days). Tokens issued for longer are rejected.
# AUTH_COOKIE_MAX_AGE_SEC=
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true
# Media lookup: TMDB v3 API key or v4 read access token (themoviedb.org/settings/api).
# Without it, movie/TV lookup is disabled; books, anime, albums and podcasts still work.
TMDB_API_KEY=
