JWT_SECRET=
LISTEN_ADDR=0.0.0.0:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development
DATABASE_URL_DEVELOPMENT=postgresql://postgres:postgres@localhost:5432/simpletracker_dev?sslmode=disable
DATABASE_URL_PRODUCTION=postgresql://postgres:postgres@localhost:5433/simpletracker_prod?sslmode=disable
DEV_AUTH_TOKEN=
DEV_AUTH_USER=dev
ALLOW_BYPASS=false
